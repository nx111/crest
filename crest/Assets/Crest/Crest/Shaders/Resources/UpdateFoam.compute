#pragma kernel UpdateFoam

#include "HLSLSupport.cginc"

#include "../OceanConstants.hlsl"
#include "../OceanGlobals.hlsl"
#include "../OceanInputsDriven.hlsl"
#include "../OceanHelpersNew.hlsl"

RWTexture2DArray<float> _LD_TexArray_Target;

CBUFFER_START(CrestPerMaterial)
float _FoamFadeRate;
float _WaveFoamStrength;
float _WaveFoamCoverage;
float _ShorelineFoamMaxDepth;
float _ShorelineFoamStrength;
float _SimDeltaTime;
float _SimDeltaTimePrev;
float _LODChange;
bool _NeedsPrewarming;
uint _CrestMinimumWavesSlice;
bool _CrestFoamStochasticRounding;
uint _CrestFoamRoundingStep;
CBUFFER_END

float CrestFoamRoundingNoise(uint3 id)
{
	uint hash = id.x * 0x8da6b343u ^ id.y * 0xd8163841u ^ id.z * 0xcb1ab31fu ^ _CrestFoamRoundingStep;
	hash = (hash ^ (hash >> 16)) * 0x7feb352du;
	hash = (hash ^ (hash >> 15)) * 0x846ca68bu;
	hash = hash ^ (hash >> 16);
	return float(hash >> 8) * (1.0 / 16777216.0);
}

float CrestFoamRoundToHalf(float foam, uint3 id)
{
	// Fixed dt is not a temporal seed. The manager advances the seed per real
	// substep, including multiple steps in one frame. Do not dither reprojection.
	if (!_CrestFoamStochasticRounding || _SimDeltaTime <= 0.0)
	{
		return foam;
	}
	uint bits = f32tof16(foam);
	float lower = f16tof32(bits);
	// f32tof16 may round up. Find the lower neighbour without assuming its mode.
	if (lower > foam)
	{
		bits = bits - 1;
		lower = f16tof32(bits);
	}
	if (lower == foam)
	{
		return foam;
	}
	const float upper = f16tof32(bits + 1);
	// Adjacent encodings also give the correct subnormal spacing (2^-24).
	// Store an exact half value so both RTZ and RNE UAV writes preserve it.
	const float probability = (foam - lower) / (upper - lower);
	return CrestFoamRoundingNoise(id) < probability ? upper : lower;
}

// Exact solution of d(foam)/dt = source - fadeRate * foam for a constant source
// during one step. The small-exponent series avoids cancellation (and 0 / 0)
// when fading is disabled. Keep this in float even with an R16 simulation target.
float2 CrestFoamDecayAndSource(float deltaTime, float fadeRate)
{
	const float dt = max(deltaTime, 0.0);
	const float rate = max(fadeRate, 0.0);
	const float exponent = rate * dt;
	const float decay = exp(-exponent);
	float sourceWeight = dt * (1.0 - exponent * (0.5 - exponent / 6.0));
	if (exponent > 0.001)
	{
		sourceWeight = (1.0 - decay) / rate;
	}
	return float2(decay, sourceWeight);
}

bool CrestFoamIsInCascade(float2 uv, float oneOverResolution)
{
	const float2 distanceFromCenter = abs(uv - 0.5);
	return max(distanceFromCenter.x, distanceFromCenter.y) <= 0.5 - oneOverResolution;
}

float2 CrestFoamSampleFlow(float2 positionXZ, uint firstSlice, uint sliceCount, float2 fallbackVelocity)
{
	// A backtrace can cross more than one cascade. Never stretch the clamped
	// edge texels across a region for which this cascade has no flow data.
	[loop]
	for (uint slice = firstSlice; slice < sliceCount; slice++)
	{
		const CascadeParams cascade = _CrestCascadeData[slice];
		const float3 uv = WorldToUV(positionXZ, cascade, slice);
		if (CrestFoamIsInCascade(uv.xy, cascade._oneOverTextureRes))
		{
			return SampleLod(_LD_TexArray_Flow, uv).xy;
		}
	}
	// Without a midpoint sample, retain the local Euler trajectory. Returning
	// zero would freeze fast-moving foam instead of letting it leave the domain.
	return fallbackVelocity;
}

float2 CrestFoamBacktrace(float2 positionXZ, float deltaTime, uint slice, uint sliceCount)
{
	const float dt = max(deltaTime, 0.0);
	const float3 uv = WorldToUV(positionXZ, _CrestCascadeData[slice], slice);
	float2 velocity = SampleLod(_LD_TexArray_Flow, uv).xy;
	if (dt > 0.0 && dot(velocity, velocity) > 0.0)
	{
		// Follow curved currents using a midpoint velocity. A single Euler
		// backtrace systematically contracts foam patches in rotational flow.
		const float2 midpoint = positionXZ - 0.5 * dt * velocity;
		velocity = CrestFoamSampleFlow(midpoint, slice, sliceCount, velocity);
	}
	return positionXZ - dt * velocity;
}

float CrestFoamSampleHistory(float2 positionXZ, uint firstSlice, uint sliceCount)
{
	[loop]
	for (uint slice = firstSlice; slice < sliceCount; slice++)
	{
		const CascadeParams cascade = _CrestCascadeDataSource[slice];
		const float3 uv = WorldToUV(positionXZ, cascade, slice);
		if (CrestFoamIsInCascade(uv.xy, cascade._oneOverTextureRes))
		{
			return SampleLod(_LD_TexArray_Foam_Source, uv).x;
		}
	}
	return 0.0;
}

[numthreads(THREAD_GROUP_SIZE_X, THREAD_GROUP_SIZE_Y, 1)]
void UpdateFoam(uint3 id : SV_DispatchThreadID)
{
	// lod data 1 is current frame, compute world pos from quad uv
	const float sliceIndex = id.z;
	float width; float height; float depth;
	{
		_LD_TexArray_Foam_Source.GetDimensions(width, height, depth);
	}
	// Slice to sample previous frames data from. LOD change takes into account shifting of the cascades in scale.
	const float sliceIndexSource = clamp(id.z + _LODChange, 0.0, depth - 1.0);

	const float2 input_uv = IDtoUV(id.xy, width, height);
	const CascadeParams cascadeData = _CrestCascadeData[sliceIndex];
	const float2 worldPosXZ = UVToWorld(input_uv, sliceIndex, cascadeData);
	const float3 uv_slice = float3(input_uv, id.z);
	float foam = 0.0;

	// Sample from previous frame.
	{
		const float2 worldPosXZ_flowed = CrestFoamBacktrace(worldPosXZ, _SimDeltaTime, id.z, (uint)depth);
		foam = CrestFoamSampleHistory(worldPosXZ_flowed, (uint)sliceIndexSource, (uint)depth);
	}

	// Integrate both loss and generation over the same step. Euler fading changes
	// foam lifetime with simulation frequency and erases history when rate * dt >= 1.
	const float2 decayAndSource = CrestFoamDecayAndSource(_SimDeltaTime, _FoamFadeRate);
	foam *= decayAndSource.x;
	float waveSourceWeight = decayAndSource.y;
	float shoreSourceWeight = decayAndSource.y;

	// Approximate a developed shoreline after loading or teleporting. Keep the
	// existing weaker wave prewarm to avoid covering small waves in fresh foam.
	// With no fading there is no finite steady state: accumulate only the real dt.
	if (_NeedsPrewarming && _FoamFadeRate > 0.0)
	{
		const float prewarmTime = 1.0 / max(_FoamFadeRate, 0.0001);
		waveSourceWeight = max(waveSourceWeight, saturate(_WaveFoamStrength - 1.0) * prewarmTime);
		shoreSourceWeight = max(shoreSourceWeight, prewarmTime);
	}

	// Sample displacement texture and generate foam from it
	const float wavesSliceIndex = min(max(_CrestMinimumWavesSlice, id.z), depth - 1.0);
	const CascadeParams wavesCascadeParams = _CrestCascadeData[wavesSliceIndex];
	const float3 wavesUV = WorldToUV(worldPosXZ, wavesCascadeParams, wavesSliceIndex);
	const float3 dd = float3(wavesCascadeParams._oneOverTextureRes, 0.0, wavesCascadeParams._texelWidth);
	half4 data = SampleLod( _LD_TexArray_AnimatedWaves, wavesUV );
	half3 s = data.xyz;
	float foamBase = data.w;
	half3 sx = SampleLodLevel(_LD_TexArray_AnimatedWaves, wavesUV + float3(dd.xy, 0.0), dd.y).xyz;
	half3 sz = SampleLodLevel(_LD_TexArray_AnimatedWaves, wavesUV + float3(dd.yx, 0.0), dd.y).xyz;
	float3 disp = s.xyz;
	float3 disp_x = dd.zyy + sx.xyz;
	float3 disp_z = dd.yyz + sz.xyz;
	// The determinant of the displacement Jacobian is a good measure for turbulence:
	// > 1: Stretch
	// < 1: Squash
	// < 0: Overlap
	const float2x2 jacobian = (float4(disp_x.xz, disp_z.xz) - disp.xzxz) / wavesCascadeParams._texelWidth;
	// Determinant is < 1 for pinched, < 0 for overlap/inversion
	const float det = determinant( jacobian );
	foam += 5.0 * waveSourceWeight * _WaveFoamStrength * saturate( _WaveFoamCoverage - det + foamBase * 0.7 );

	// Filtering the waves used for whitecaps must not change the shoreline's
	// displaced sampling position or water depth. Reuse the sample at filter zero.
	if (wavesSliceIndex > sliceIndex)
	{
		disp = SampleLod(_LD_TexArray_AnimatedWaves, uv_slice).xyz;
	}

	// Add foam in shallow water. use the displaced position to ensure we add foam where world objects are.
	const float3 uv_slice_displaced = WorldToUV(worldPosXZ + disp.xz, cascadeData, sliceIndex);
	float2 terrainHeight_seaLevelOffset = _LD_TexArray_SeaFloorDepth.SampleLevel(LODData_linear_clamp_sampler, uv_slice_displaced, 0.0).xy;
	terrainHeight_seaLevelOffset.x = max(terrainHeight_seaLevelOffset.x, -CREST_FLOAT_MAXIMUM);
	const float signedOceanDepth = _OceanCenterPosWorld.y - terrainHeight_seaLevelOffset.x + terrainHeight_seaLevelOffset.y + disp.y;
	foam += _ShorelineFoamStrength * shoreSourceWeight * saturate(1.0 - signedOceanDepth / max(_ShorelineFoamMaxDepth, 0.0001));

	// Keep the existing simulation coverage clamp after decay and generation.
	// Additive inputs can still deposit values above one after this dispatch.
	_LD_TexArray_Target[id] = CrestFoamRoundToHalf(saturate(foam), id);
}
